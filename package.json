{
  "name": "gameao",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outdir=dist-server",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "start": "NODE_ENV=production node dist-server/index.js",
    "admin:init": "tsx server/admin-init.ts",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
