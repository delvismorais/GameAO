# Servidor
PORT=3000
NODE_ENV=development

# Base de dados PostgreSQL (obrigatória para catálogo, contas, encomendas e faturas)
DATABASE_URL=postgresql://gameao:gameao@127.0.0.1:5432/gameao
DB_POOL_SIZE=8
# Ative apenas quando a ligação exigir TLS (por exemplo, um endpoint público gerido)
DATABASE_SSL=false

# Primeiro administrador (usado apenas por `pnpm admin:init`)
GAMEAO_ADMIN_EMAIL=
GAMEAO_ADMIN_PASSWORD=
GAMEAO_ADMIN_NAME=Administrador GameAO

# Email transacional (opcional; sem estes valores as notificações ficam como not_configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp Business API (opcional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
