# Servidor
PORT=3000
NODE_ENV=development

# Base de dados PostgreSQL (obrigatória para catálogo, contas, encomendas e faturas)
DATABASE_URL=postgresql://user:password@host:5432/database
DB_POOL_SIZE=8
DB_PASSWORD=

# Cloudflare R2 (armazenamento privado de comprovativos e imagens administrativas)
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=gameao-assets
R2_PUBLIC_BASE_URL=https://media.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Primeiro administrador (usado apenas por `pnpm admin:init`)
GAMEAO_ADMIN_EMAIL=
GAMEAO_ADMIN_PASSWORD=
GAMEAO_ADMIN_NAME=Administrador GameAO

# Email transacional (opcional; sem estes valores as notificações ficam como not_configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# WhatsApp Business API (opcional)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
